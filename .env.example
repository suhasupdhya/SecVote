# Copy to apps/api/.env and fill in. Never commit real values.

# --- API ---
SECVOTE_ENV=dev
SECVOTE_MONGODB_URI=mongodb://127.0.0.1:27017
SECVOTE_MONGODB_DB=secvote
# Leave empty to use the in-process fakeredis fallback (dev/tests only)
SECVOTE_REDIS_URL=
# 32+ random bytes, e.g. `python -c "import secrets;print(secrets.token_hex(32))"`
SECVOTE_SESSION_SECRET=change-me
SECVOTE_OTP_PEPPER=change-me
SECVOTE_COOKIE_SECURE=false
SECVOTE_ALLOWED_EMAIL_DOMAINS=["example.edu.in"]

# Email: console | smtp | resend
SECVOTE_EMAIL_BACKEND=console
SECVOTE_EMAIL_FROM=SecVote <no-reply@example.edu.in>
SECVOTE_SMTP_HOST=
SECVOTE_SMTP_PORT=587
SECVOTE_SMTP_USER=
SECVOTE_SMTP_PASSWORD=
SECVOTE_RESEND_API_KEY=
# Owners, admins and officers confirm every sign-in with an emailed code (keep true outside local testing)
SECVOTE_OFFICIAL_LOGIN_CODE=true
# Public address of the website; links in emails (e.g. "apply again") point here
SECVOTE_WEB_URL=http://localhost:3000

# --- Chain ---
SECVOTE_RPC_URL=http://127.0.0.1:8545
SECVOTE_CHAIN_ID=31337
# Relayer key: fund with a small balance only. Anvil account #1 by default in dev.
SECVOTE_RELAYER_PRIVATE_KEY=
SECVOTE_CONFIRMATIONS=1
