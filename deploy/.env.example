# Copy to deploy/.env (used by docker compose for build arguments and the domain).

# Your site's domain; point its DNS A/AAAA record at this server first.
SECVOTE_DOMAIN=vote.example.edu

# Blockchain the browser reads from (must match SECVOTE_RPC_URL / SECVOTE_CHAIN_ID in api.env).
# Use a provider URL meant for public/browser use (e.g. the network's public RPC, or a provider key that is
# restricted to your domain). Example: Base Sepolia test network.
NEXT_PUBLIC_RPC_URL=https://sepolia.base.org
NEXT_PUBLIC_CHAIN_ID=84532

# Privacy notice (/privacy): who runs this site, and the email for data questions and complaints.
NEXT_PUBLIC_INSTITUTION_NAME=Your College Name
NEXT_PUBLIC_PRIVACY_CONTACT=privacy@yourcollege.edu.in

# Largest voter roll you expect: 2^depth voters (16 -> 65,536; 18 -> 262,144; 20 -> ~1 million).
SNARK_MAX_DEPTH=16
