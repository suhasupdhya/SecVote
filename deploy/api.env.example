# Copy to deploy/api.env and fill in. NEVER commit the real file (it is gitignored and dockerignored).
# The API and the worker refuse to start in production if a required value is missing or unsafe.

SECVOTE_ENV=prod

# --- Database: a NEW production database (MongoDB Atlas recommended, with backups turned on)
SECVOTE_MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.example.mongodb.net
SECVOTE_MONGODB_DB=secvote

# --- Secrets: two different long random values, e.g.
#   python -c "import secrets; print(secrets.token_hex(32))"
SECVOTE_SESSION_SECRET=
SECVOTE_OTP_PEPPER=
SECVOTE_COOKIE_SECURE=true

# --- Who may sign up: your institution's email domain(s) only
SECVOTE_ALLOWED_EMAIL_DOMAINS=["yourcollege.edu.in"]

# --- Public address (links in emails) and allowed browser origin
SECVOTE_WEB_URL=https://vote.example.edu
SECVOTE_CORS_ORIGINS=["https://vote.example.edu"]

# --- Email: a transactional provider (Gmail's ~500 emails/day limit is too low for invitations)
SECVOTE_EMAIL_BACKEND=resend
SECVOTE_EMAIL_FROM=SecVote <no-reply@yourcollege.edu.in>
SECVOTE_RESEND_API_KEY=
# or SMTP:
# SECVOTE_EMAIL_BACKEND=smtp
# SECVOTE_SMTP_HOST=
# SECVOTE_SMTP_PORT=587
# SECVOTE_SMTP_USER=
# SECVOTE_SMTP_PASSWORD=

SECVOTE_OFFICIAL_LOGIN_CODE=true

# --- Blockchain (server side; the same network as NEXT_PUBLIC_* in deploy/.env)
SECVOTE_RPC_URL=https://sepolia.base.org
SECVOTE_CHAIN_ID=84532
# The relayer pays the fee for every ballot and admin action. A dedicated key holding a small balance only.
SECVOTE_RELAYER_PRIVATE_KEY=
# Wait for this many blocks before trusting a transaction (2-3 on public networks).
SECVOTE_CONFIRMATIONS=2
# /readyz reports "low" below this balance (in wei; 10000000000000000 = 0.01 ETH). Monitor /readyz.
SECVOTE_RELAYER_MIN_BALANCE_WEI=10000000000000000

# --- Where ID-card files are kept: "disk" (the uploads volume in docker-compose.yml) or "mongo" (in the database;
# for hosts without a lasting disk shared by the API and the worker, e.g. Render).
SECVOTE_UPLOAD_STORAGE=disk
# Ballots allowed per minute from one visitor address. A whole campus Wi-Fi can share one address: be generous.
SECVOTE_BALLOT_RATE_LIMIT_PER_MINUTE=300
