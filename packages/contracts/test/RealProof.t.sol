pragma solidity ^0.8.28;

import {ISemaphore} from "@semaphore-protocol/contracts/interfaces/ISemaphore.sol";
import {ISemaphoreVerifier} from "@semaphore-protocol/contracts/interfaces/ISemaphoreVerifier.sol";
import {SemaphoreVerifier} from "@semaphore-protocol/contracts/base/SemaphoreVerifier.sol";
import {ElectionTestBase} from "./Base.t.sol";
import {Election} from "../src/Election.sol";
import {BallotFormat} from "../src/BallotFormat.sol";

// Real Groth16 proofs generated by the Semaphore JS library through FFI (scripts/proof.mjs).
// Requires node and network access on first run (circuit artifacts are downloaded and cached).
contract RealProofTest is ElectionTestBase {
    string internal constant MEMBERS = "voter-1,voter-2,voter-3";

    function _verifier() internal override returns (ISemaphoreVerifier) {
        return ISemaphoreVerifier(address(new SemaphoreVerifier()));
    }

    function _commitment(string memory seed) internal returns (uint256) {
        string[] memory cmd = new string[](4);
        cmd[0] = "node";
        cmd[1] = "scripts/proof.mjs";
        cmd[2] = "commitment";
        cmd[3] = seed;
        return abi.decode(vm.ffi(cmd), (uint256));
    }

    function _realProof(string memory seed, uint256 scope, bytes memory ballot, string memory members)
        internal
        returns (ISemaphore.SemaphoreProof memory p)
    {
        string[] memory cmd = new string[](7);
        cmd[0] = "node";
        cmd[1] = "scripts/proof.mjs";
        cmd[2] = "prove";
        cmd[3] = seed;
        cmd[4] = vm.toString(scope);
        cmd[5] = vm.toString(uint256(keccak256(ballot)));
        cmd[6] = members;
        (uint256 d, uint256 root, uint256 n, uint256 m, uint256 s, uint256[8] memory pts) =
            abi.decode(vm.ffi(cmd), (uint256, uint256, uint256, uint256, uint256, uint256[8]));
        p = ISemaphore.SemaphoreProof(d, root, n, m, s, pts);
    }

    function setUp() public override {
        super.setUp();
        uint256[] memory c = new uint256[](3);
        c[0] = _commitment("voter-1");
        c[1] = _commitment("voter-2");
        c[2] = _commitment("voter-3");
        _register(election, c);
        _openVoting(election);
    }

    function test_Real_MemberVotesOnce() public {
        bytes memory b = _ballot(2, 1);
        election.castBallot(_realProof("voter-1", election.scope(), b, MEMBERS), b);
        assertEq(election.ballotCount(), 1);
        assertEq(election.results(0)[2], 1);

        // Same identity, new ballot, fresh valid proof: same nullifier -> rejected.
        bytes memory b2 = _ballot(0, 0);
        ISemaphore.SemaphoreProof memory again = _realProof("voter-1", election.scope(), b2, MEMBERS);
        vm.expectRevert(Election.Election__NullifierUsed.selector);
        election.castBallot(again, b2);
    }

    function test_Real_RevertWhen_NonMember() public {
        // An outsider builds a group containing themselves: the root cannot match the frozen roll.
        bytes memory b = _ballot(0, 0);
        ISemaphore.SemaphoreProof memory p =
            _realProof("outsider", election.scope(), b, "voter-1,voter-2,outsider");
        vm.expectRevert(Election.Election__RootNotFrozenRoot.selector);
        election.castBallot(p, b);
    }

    function test_Real_RevertWhen_ForgedNullifier() public {
        // Change the nullifier on a valid proof to try to vote twice: the SNARK no longer verifies.
        bytes memory b = _ballot(0, 0);
        ISemaphore.SemaphoreProof memory p = _realProof("voter-2", election.scope(), b, MEMBERS);
        p.nullifier = p.nullifier + 1;
        vm.expectRevert(Election.Election__InvalidProof.selector);
        election.castBallot(p, b);
    }

    function test_Real_RevertWhen_ProofForOtherElection() public {
        bytes memory b = _ballot(0, 0);
        ISemaphore.SemaphoreProof memory p = _realProof("voter-2", uint256(123), b, MEMBERS);
        vm.expectRevert(Election.Election__WrongScope.selector);
        election.castBallot(p, b);
    }

    /// A front-runner copies the proof from the mempool and burns it via Semaphore.validateProof.
    /// Because Election keeps its own nullifiers, the voter's ballot still lands.
    function test_Real_FrontRunValidateProofCannotGriefVoter() public {
        bytes memory b = _ballot(1, 1);
        ISemaphore.SemaphoreProof memory p = _realProof("voter-3", election.scope(), b, MEMBERS);
        vm.prank(attacker);
        semaphore.validateProof(election.groupId(), p);
        election.castBallot(p, b);
        assertEq(election.ballotCount(), 1);
    }

    function test_Real_ZeroPaddingMatchesSpec() public pure {
        assertEq(BallotFormat.OPEN_BALLOT_SIZE, 64);
    }
}
